{
  "version": 2,
  "functions": {
    "api/data.js": { "maxDuration": 30 },
    "api/power.js": { "maxDuration": 30 },
    "api/goat.js": { "maxDuration": 30 },
    "api/history.js": { "maxDuration": 30 }
  },
  "headers": [
    { "source": "/api/(.*)", "headers": [ { "key": "X-Content-Type-Options", "value": "nosniff" } ] },
    { "source": "/sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
  ]
}
