{
  "version": 2,
  "functions": {
    "api/data.js": {
      "maxDuration": 30
    },
    "api/power.js": {
      "maxDuration": 30
    },
    "api/goat.js": {
      "maxDuration": 30
    },
    "api/history.js": {
      "maxDuration": 30
    },
    "api/insight.js": {
      "maxDuration": 60
    },
    "api/lab.js": {
      "maxDuration": 60
    },
    "api/season.js": {
      "maxDuration": 60
    },
    "api/intel.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
